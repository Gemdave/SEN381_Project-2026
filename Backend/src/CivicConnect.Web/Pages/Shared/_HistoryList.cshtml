@*
    Presentation only. Staff see this because their capabilities say so, not
    because the partial checks anything (ADR-004, AC-013.1).
*@
@model IReadOnlyList<CivicConnect.Core.Models.HistoryEntry>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model="@("Nothing has been recorded yet.")" />
}
else
{
    <ol class="history">
        @foreach (var entry in Model)
        {
            <li>
                <time datetime="@entry.CreatedAt.ToString("o")">@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm")</time>
                <span class="action">@entry.Action</span>
                @if (entry.FromStatus is not null)
                {
                    <span class="change">@StatusRules.Display(entry.FromStatus.Value) to @StatusRules.Display(entry.ToStatus)</span>
                }
                @if (!string.IsNullOrWhiteSpace(entry.Note))
                {
                    <span class="note">@entry.Note</span>
                }
            </li>
        }
    </ol>
}
