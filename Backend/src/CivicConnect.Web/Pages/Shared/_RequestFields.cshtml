@*
    Presentation only: the fields of one request. No controls, so a page that
    renders this alone is read only by construction (AC-003.2).
*@
@model CivicConnect.Core.Models.ServiceRequest

<dl class="fields">
    <dt>Reference</dt><dd>@Model.Reference</dd>
    <dt>Status</dt><dd><status-badge status="@Model.Status"></status-badge></dd>
    <dt>Category</dt><dd>@Model.CategoryName</dd>
    <dt>Location</dt><dd>@Model.Location</dd>
    <dt>Submitted</dt><dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt>Last updated</dt><dd>@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt>Description</dt><dd>@Model.Description</dd>
</dl>
