@*
    Presentation only: it knows how a request looks in a list and nothing about
    roles. Both the requester history and the staff queue use it (ADR-004).
*@
@model CivicConnect.Core.Models.ServiceRequest

<article class="summary">
    <a class="reference" href="@Model.DetailPath()">@Model.Reference</a>
    <h3>@Model.Title</h3>
    <p class="meta">
        <status-badge status="@Model.Status"></status-badge>
        <span class="category">@Model.CategoryName</span>
        <span class="location">@Model.Location</span>
        <time datetime="@Model.CreatedAt.ToString("o")">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</time>
    </p>
</article>
