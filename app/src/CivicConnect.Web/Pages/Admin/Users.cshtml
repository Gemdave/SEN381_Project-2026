@page
@model CivicConnect.Web.Pages.Admin.UsersModel
@using CivicConnect.Domain.Access
@{
    ViewData["Title"] = "Users";
    var roles = Enum.GetValues<UserRole>();
}

<h1>Users and roles</h1>

@if (Model.Message is not null)
{
    <partial name="_Message" model="Model.Message" />
}

@if (!Model.Allowed)
{
    <partial name="_EmptyState" model="@("User and role management is for administrators.")" />
}
else
{
    @* FR-019: accounts are created here and never deleted. *@
    <form method="post" asp-page-handler="Create" class="filters">
        <label>
            Name
            <input name="name" maxlength="@AppUser.DisplayNameMax" />
        </label>
        <label>
            Role
            <select name="role">
                @foreach (var role in roles)
                {
                    <option value="@role">@CivicConnect.Web.Pages.Admin.UsersModel.RoleText(role)</option>
                }
            </select>
        </label>
        <button type="submit">Create user</button>
    </form>

    <table class="admin-list">
        <tr><th>Name</th><th>Role</th><th>State</th><th>Categories (staff only)</th><th></th></tr>
        @foreach (var user in Model.Items)
        {
            var self = user.Id == Model.CurrentUserId;
            <tr class="@(user.IsActive ? "" : "inactive")">
                <td>@user.DisplayName@(self ? " (you)" : "")</td>
                <td>
                    @if (self)
                    {
                        @CivicConnect.Web.Pages.Admin.UsersModel.RoleText(user.Role)
                    }
                    else
                    {
                        @* FR-020, AC-020.1: what the user may do follows the role. *@
                        <form method="post" asp-page-handler="Role" class="inline">
                            <input type="hidden" name="id" value="@user.Id" />
                            <select name="role" aria-label="Role for @user.DisplayName">
                                @foreach (var role in roles)
                                {
                                    <option value="@role" selected="@(user.Role == role)">@CivicConnect.Web.Pages.Admin.UsersModel.RoleText(role)</option>
                                }
                            </select>
                            <button type="submit">Change</button>
                        </form>
                    }
                </td>
                <td>@(user.IsActive ? "Active" : "Deactivated")</td>
                <td>
                    @if (user.Role == UserRole.ServiceStaff)
                    {
                        @* FR-008: staff see and work only the categories ticked here. *@
                        <form method="post" asp-page-handler="Scopes" class="inline scopes">
                            <input type="hidden" name="id" value="@user.Id" />
                            @foreach (var category in Model.Categories.Where(c => !c.IsRetired || user.ScopedCategoryIds.Contains(c.Id)))
                            {
                                <label class="inline-check">
                                    <input type="checkbox" name="categoryIds" value="@category.Id" checked="@user.ScopedCategoryIds.Contains(category.Id)" />
                                    @category.Name
                                </label>
                            }
                            <button type="submit">Save</button>
                        </form>
                    }
                </td>
                <td>
                    @if (!self)
                    {
                        <form method="post" asp-page-handler="@(user.IsActive ? "Deactivate" : "Reactivate")" class="inline">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="@(user.IsActive ? "danger" : "secondary")">@(user.IsActive ? "Deactivate" : "Reactivate")</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </table>
}
