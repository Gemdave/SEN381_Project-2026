@page
@model CivicConnect.Web.Pages.Admin.UsersModel
@using CivicConnect.Domain.Access
@{
    ViewData["Title"] = "Users";
    var roles = Enum.GetValues<UserRole>();
    var categoryNames = Model.Categories.ToDictionary(c => c.Id, c => c.Name);
}

<h1>Users and roles</h1>

@if (Model.Message is not null)
{
    <partial name="_Message" model="Model.Message" />
}

@if (!Model.Allowed)
{
    <partial name="_EmptyState" model="@("User and role management is for administrators.")" />
}
else
{
    @* FR-019: accounts are created here and never deleted. *@
    <section class="create">
        <h2>Create a user</h2>
        <form method="post" asp-page-handler="Create" class="inline">
            <input name="name" maxlength="@AppUser.DisplayNameMax" placeholder="Full name" aria-label="Name" />
            <input name="email" type="email" maxlength="@AppUser.EmailMax" placeholder="Email (to sign in)" aria-label="Email" autocomplete="off" />
            <input name="temporaryPassword" type="text" maxlength="@PasswordPolicy.MaxLength" placeholder="Temporary password" aria-label="Temporary password" autocomplete="off" />
            <select name="role" aria-label="Role">
                @foreach (var role in roles)
                {
                    <option value="@role">@CivicConnect.Web.Pages.Admin.UsersModel.RoleText(role)</option>
                }
            </select>
            <button type="submit">Create user</button>
        </form>
        <p class="hint">With an email and a temporary password (at least @PasswordPolicy.MinLength characters) the user can sign in and must choose their own password first. Share the temporary password in person or by phone, not by email.</p>
    </section>

    <table class="admin-list">
        <thead>
            <tr><th>Name</th><th>Role</th><th>State</th><th>Categories</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Items)
            {
                var self = user.Id == Model.CurrentUserId;
                var isStaff = user.Role == UserRole.ServiceStaff;
                var scoped = user.ScopedCategoryIds.Where(categoryNames.ContainsKey).Select(id => categoryNames[id]).Order().ToList();
                <tr class="@(user.IsActive ? null : "inactive")">
                    <td>@user.DisplayName@(self ? " (you)" : "")@if (user.Email is not null) { <br /><span class="hint">@user.Email</span> }</td>
                    <td>@CivicConnect.Web.Pages.Admin.UsersModel.RoleText(user.Role)</td>
                    <td>@(user.IsActive ? "Active" : "Deactivated")</td>
                    <td>
                        @if (isStaff)
                        {
                            @(scoped.Count == 0 ? "None yet" : string.Join(", ", scoped))
                        }
                        else
                        {
                            <span class="hint">Staff only</span>
                        }
                    </td>
                    <td class="edit-cell">
                        @if (self)
                        {
                            <span class="hint">Your account</span>
                        }
                        else
                        {
                            <details class="row-edit">
                                <summary>Edit</summary>
                                <div class="row-edit-panel">
                                    @* FR-020, AC-020.1: what the user may do follows the role. *@
                                    <form method="post" asp-page-handler="Role">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <label for="role-@user.Id">Role</label>
                                        <select id="role-@user.Id" name="role">
                                            @foreach (var role in roles)
                                            {
                                                <option value="@role" selected="@(user.Role == role)">@CivicConnect.Web.Pages.Admin.UsersModel.RoleText(role)</option>
                                            }
                                        </select>
                                        <button type="submit" class="small">Change role</button>
                                    </form>

                                    @if (isStaff)
                                    {
                                        @* FR-008: staff see and work only the categories ticked here. *@
                                        <form method="post" asp-page-handler="Scopes">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <span class="hint">Categories this staff member handles</span>
                                            <div class="scopes">
                                                @foreach (var category in Model.Categories.Where(c => !c.IsRetired || user.ScopedCategoryIds.Contains(c.Id)))
                                                {
                                                    <label class="inline-check">
                                                        <input type="checkbox" name="categoryIds" value="@category.Id" checked="@user.ScopedCategoryIds.Contains(category.Id)" />
                                                        @category.Name
                                                    </label>
                                                }
                                            </div>
                                            <button type="submit" class="small">Save categories</button>
                                        </form>
                                    }

                                    @if (user.Email is not null)
                                    {
                                        @* CR-003: a forgotten password. This also clears a lockout and ends their sessions. *@
                                        <form method="post" asp-page-handler="ResetPassword">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <label for="reset-@user.Id">Temporary password</label>
                                            <input id="reset-@user.Id" name="temporaryPassword" type="text" autocomplete="off" maxlength="@PasswordPolicy.MaxLength" />
                                            <button type="submit" class="small">Reset password</button>
                                        </form>
                                    }

                                    @* FR-019, AC-019.1: deactivated users cannot sign in or act. *@
                                    <form method="post" asp-page-handler="@(user.IsActive ? "Deactivate" : "Reactivate")">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="small @(user.IsActive ? "danger" : "secondary")">@(user.IsActive ? "Deactivate" : "Reactivate")</button>
                                    </form>
                                </div>
                            </details>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
