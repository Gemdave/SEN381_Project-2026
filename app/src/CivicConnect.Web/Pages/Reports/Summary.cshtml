@page
@model CivicConnect.Web.Pages.Reports.SummaryModel
@{
    ViewData["Title"] = "Service summary";
}

<h1>Service summary</h1>

@if (!Model.Allowed)
{
    <partial name="_EmptyState" model="@("The service summary is for sponsors, managers and administrators.")" />
}
else
{
    var s = Model.Summary!;
    @* FR-023, AC-023.1: summary service performance and accountability figures. *@
    <dl class="fields summary">
        <dt>Requests received</dt><dd class="total">@s.Total</dd>
        <dt>Still open</dt><dd class="open">@s.Open</dd>
        <dt>Open and overdue</dt><dd class="overdue-count">@s.Overdue</dd>
        <dt>Resolved</dt><dd class="resolved">@s.Resolved</dd>
        <dt>Resolved within target</dt>
        <dd class="within-target">@(Model.WithinTargetPercent is { } percent ? percent + "%" : "None resolved yet")</dd>
        <dt>Average time to resolve</dt>
        <dd>@(s.AverageHoursToResolve is null ? "None resolved yet" : CivicConnect.Web.Pages.Oversight.IndexModel.Hours(s.AverageHoursToResolve) + " hours")</dd>
    </dl>

    <table>
        <caption>Requests by status</caption>
        @foreach (var row in s.ByStatus)
        {
            <tr><th><status-badge status="@row.Status"></status-badge></th><td>@row.Count</td></tr>
        }
    </table>

    <p class="hint">Figures are counted from the request records when this page loads.</p>
}
