@page
@model CivicConnect.Web.Pages.Reports.SummaryModel
@{
    ViewData["Title"] = "Service summary";
}

<h1>Service summary</h1>

@if (!Model.Allowed)
{
    <partial name="_EmptyState" model="@("The service summary is for sponsors, managers and administrators.")" />
}
else
{
    var s = Model.Summary!;
    <p class="lead">Headline service performance, counted from the request records when this page loads.</p>

    @* FR-023, AC-023.1: summary service performance and accountability figures. *@
    <dl class="stats">
        <div class="stat"><dt>Requests received</dt><dd class="total">@s.Total</dd></div>
        <div class="stat"><dt>Still open</dt><dd class="open">@s.Open</dd></div>
        <div class="stat warn"><dt>Open and overdue</dt><dd class="overdue-count">@s.Overdue</dd></div>
        <div class="stat good"><dt>Resolved</dt><dd class="resolved">@s.Resolved</dd></div>
        <div class="stat"><dt>Resolved within target</dt><dd class="within-target">@(Model.WithinTargetPercent is { } percent ? percent + "%" : "None yet")</dd></div>
        <div class="stat"><dt>Average time to resolve</dt><dd>@(s.AverageHoursToResolve is null ? "None yet" : CivicConnect.Web.Pages.Oversight.IndexModel.Hours(s.AverageHoursToResolve) + " h")</dd></div>
    </dl>

    <h2>Requests by status</h2>
    <partial name="_StatusBars" model="s.ByStatus" />
}
