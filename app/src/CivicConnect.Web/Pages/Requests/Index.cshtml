@page
@model CivicConnect.Web.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "My requests";
}

<div class="page-heading">
    <h1>My requests</h1>
    <a href="/Requests/Submit" class="button">Submit a new request</a>
</div>

@* FR-005, AC-005.1: filter your own requests by status. *@
<form method="get" class="filters">
    <label>
        Status
        <select name="status">
            <option value="">Any</option>
            @foreach (var status in Enum.GetValues<RequestStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@(status == RequestStatus.InProgress ? "In progress" : status.ToString())</option>
            }
        </select>
    </label>
    <button type="submit" class="secondary">Filter</button>
    @if (Model.Status is not null)
    {
        <a href="/Requests">Show all</a>
    }
</form>

@if (Model.Items.Count == 0)
{
    <partial name="_EmptyState" model="@(Model.Status is null ? "You have not submitted any requests yet." : "No requests match this filter.")" />
}
else
{
    @* FR-004: only this requester's own requests, newest first (NFR-003). *@
    <table class="data">
        <thead>
            <tr>
                <th>Reference</th>
                <th>Title</th>
                <th>Category</th>
                <th>Status</th>
                <th>Submitted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><a href="/Requests/Details?id=@item.Id">@item.Reference</a></td>
                    <td>@item.Title</td>
                    <td>@item.CategoryName</td>
                    <td><status-badge status="@item.Status"></status-badge></td>
                    <td><time datetime="@item.CreatedAtUtc.ToString("o")">@DisplayTime.Show(item.CreatedAtUtc)</time></td>
                </tr>
            }
        </tbody>
    </table>
}
