@page
@model CivicConnect.Web.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "My requests";
}

<h1>My requests</h1>
<p><a href="/Requests/Submit">Submit a new request</a></p>

@* FR-005, AC-005.1: filter your own requests by status. *@
<form method="get" class="filters">
    <label>
        Status
        <select name="status">
            <option value="">Any</option>
            @foreach (var status in Enum.GetValues<RequestStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@(status == RequestStatus.InProgress ? "In progress" : status.ToString())</option>
            }
        </select>
    </label>
    <button type="submit">Filter</button>
    @if (Model.Status is not null)
    {
        <a href="/Requests">Show all</a>
    }
</form>

@if (Model.Items.Count == 0)
{
    <partial name="_EmptyState" model="@(Model.Status is null ? "You have not submitted any requests yet." : "No requests match this filter.")" />
}
else
{
    foreach (var item in Model.Items)
    {
        <article class="request-summary">
            <a href="/Requests/Details?id=@item.Id">@item.Reference</a>
            <h3>@item.Title</h3>
            <status-badge status="@item.Status"></status-badge>
            <span class="category">@item.CategoryName</span>
            <time datetime="@item.CreatedAtUtc.ToString("o")">@item.CreatedAtUtc.ToString("u")</time>
        </article>
    }
}
