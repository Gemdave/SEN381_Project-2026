@page
@model CivicConnect.Web.Pages.Requests.SubmitModel
@{
    ViewData["Title"] = "Submit a request";
}

<h1>Submit a request</h1>
<p class="lead">Five short steps. Every field is needed so staff can act on it straight away.</p>

@* NFR-001: five numbered steps, one column, so a first-time requester can see
   how far there is to go: title, description, location, category, submit. *@
<form method="post" class="steps" novalidate>
    <div asp-validation-summary="ModelOnly" class="errors"></div>

    <div class="step">
        <label asp-for="Input.Title"><span class="step-number">1</span>Give it a short title</label>
        <input asp-for="Input.Title" maxlength="@CivicConnect.Domain.Requests.Request.TitleMax" placeholder="For example: Broken light in the corridor" />
        <span asp-validation-for="Input.Title" class="field-error"></span>
    </div>

    <div class="step">
        <label asp-for="Input.Description"><span class="step-number">2</span>What needs attention</label>
        <textarea asp-for="Input.Description" rows="5" maxlength="@CivicConnect.Domain.Requests.Request.DescriptionMax"></textarea>
        <span asp-validation-for="Input.Description" class="field-error"></span>
    </div>

    <div class="step">
        <label asp-for="Input.Location"><span class="step-number">3</span>Where is it</label>
        <input asp-for="Input.Location" maxlength="@CivicConnect.Domain.Requests.Request.LocationMax" placeholder="Building, floor or room" />
        <span asp-validation-for="Input.Location" class="field-error"></span>
    </div>

    @* FR-002: the controlled category list, as tiles rather than a dropdown. *@
    <fieldset class="step">
        <legend><span class="step-number">4</span>Choose a category</legend>
        <div class="tiles">
            @foreach (var category in Model.Categories)
            {
                <label class="tile"><input type="radio" name="Input.CategoryId" value="@category.Id" checked="@(Model.Input.CategoryId == category.Id)" /> <span>@category.Name</span></label>
            }
        </div>
        <span asp-validation-for="Input.CategoryId" class="field-error"></span>
    </fieldset>

    <div class="step">
        <span class="step-label"><span class="step-number">5</span>Send it</span>
        <button type="submit">Submit request</button>
    </div>
</form>
