@model CivicConnect.Web.Models.HistoryView

@if (Model.Entries.Count == 0)
{
    <partial name="_EmptyState" model="@("No actions recorded yet.")" />
}
else
{
    <ul class="history">
        @foreach (var entry in Model.Entries)
        {
            <li>
                <time datetime="@entry.OccurredAtUtc.ToString("o")">@entry.OccurredAtUtc.ToString("u")</time>
                <span class="action">@CivicConnect.Web.Models.HistoryView.ActionText(entry.Action)</span>
                @if (entry.OldValue is not null || entry.NewValue is not null)
                {
                    <span class="change">@(entry.OldValue is null ? "" : Model.ValueText(entry.OldValue) + " ")to @Model.ValueText(entry.NewValue)</span>
                }
                <span class="actor">by @Model.NameOf(entry.ActorUserId)</span>
            </li>
        }
    </ul>
}
