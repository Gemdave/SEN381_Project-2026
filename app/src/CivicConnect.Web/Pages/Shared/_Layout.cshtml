@using CivicConnect.Domain.Access
@using CivicConnect.Infrastructure.Persistence
@using CivicConnect.Web.Security
@using Microsoft.EntityFrameworkCore
@inject IWebHostEnvironment HostEnvironment
@inject CivicConnectDbContext Db
@inject ICurrentUser CurrentUser
@inject CivicConnect.Application.Abstractions.IAuthorisationPolicy Policy
@{
    // ADR-004: links appear only for roles the policy allows; each page checks again.
    var canSubmit = await Policy.MaySubmitAsync(CurrentUser.Id, default);
    var canOversee = await Policy.MayViewOversightAsync(CurrentUser.Id, default);
    var canAdminister = await Policy.MayAdministerAsync(CurrentUser.Id, default);
    var canSeeSummary = await Policy.MayViewSummaryAsync(CurrentUser.Id, default);

    // The identity only ever names an active user (DevelopmentCurrentUser).
    var me = await Db.Users.AsNoTracking()
        .Where(u => u.Id == CurrentUser.Id && u.IsActive)
        .Select(u => new { u.DisplayName, u.Role })
        .FirstOrDefaultAsync();
    var isStaff = me?.Role == UserRole.ServiceStaff;

    // The nav link for the page being shown gets aria-current="page", which the
    // stylesheet underlines. Details pages count as part of their list.
    var path = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    string? CurrentFor(string href)
    {
        var current = href switch
        {
            "/Requests" => path.Equals("/Requests", StringComparison.OrdinalIgnoreCase)
                || path.Equals("/Requests/Details", StringComparison.OrdinalIgnoreCase),
            "/Staff/Queue" => path.Equals("/Staff/Queue", StringComparison.OrdinalIgnoreCase)
                || path.Equals("/Staff/Details", StringComparison.OrdinalIgnoreCase),
            _ => path.Equals(href, StringComparison.OrdinalIgnoreCase)
        };
        return current ? "page" : null;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CivicConnect</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
      <div class="site-header"><div class="shell">
        <a href="@(me is null ? "/" : "/Home")" class="brand"><strong>CivicConnect</strong></a>
        <nav class="site-nav" aria-label="Main">
            @if (canSubmit)
            {
                <a href="/Requests/Submit" aria-current="@CurrentFor("/Requests/Submit")">Submit a request</a>
                <a href="/Requests" aria-current="@CurrentFor("/Requests")">My requests</a>
            }
            @if (isStaff)
            {
                <a href="/Staff/Queue" aria-current="@CurrentFor("/Staff/Queue")">Staff queue</a>
            }
            @if (canOversee)
            {
                <a href="/Oversight" aria-current="@CurrentFor("/Oversight")">Oversight</a>
            }
            @if (canSeeSummary)
            {
                <a href="/Reports/Summary" aria-current="@CurrentFor("/Reports/Summary")">Summary</a>
            }
            @if (canAdminister)
            {
                <a href="/Admin/Users" aria-current="@CurrentFor("/Admin/Users")">Users</a>
                <a href="/Admin/Categories" aria-current="@CurrentFor("/Admin/Categories")">Categories</a>
                <a href="/Admin/Audit" aria-current="@CurrentFor("/Admin/Audit")">Audit trail</a>
            }
        </nav>
        @* Development only: the CR-003 stand-in for sign-in (RSK-012). Who to be
           is chosen on the sign-in page at the site root. *@
        @if (HostEnvironment.IsDevelopment())
        {
            <div class="signed-in-as">
                @if (me is null)
                {
                    <span>Not signed in</span>
                    <a href="/">Choose a user</a>
                }
                else
                {
                    <span><strong class="current-user">@me.DisplayName</strong> (@CivicConnect.Web.Pages.Admin.UsersModel.RoleText(me.Role))</span>
                    <a href="/">Switch user</a>
                }
            </div>
        }
        else
        {
            @* CR-003: real sign-in. Signing out is a POST so another site cannot trigger it. *@
            <div class="signed-in-as">
                @if (me is null)
                {
                    <a href="/Account/SignIn">Sign in</a>
                }
                else
                {
                    <span><strong class="current-user">@me.DisplayName</strong> (@CivicConnect.Web.Pages.Admin.UsersModel.RoleText(me.Role))</span>
                    <a href="/Account/ChangePassword">Change password</a>
                    <form method="post" asp-page="/Account/SignOut" class="sign-out">
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                }
            </div>
        }
      </div></div>
    </header>
    <main>
        <div class="shell page">
            @RenderBody()
        </div>
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
