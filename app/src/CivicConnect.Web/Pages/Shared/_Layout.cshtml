@using CivicConnect.Infrastructure.Persistence
@using CivicConnect.Web.Security
@using Microsoft.EntityFrameworkCore
@inject IWebHostEnvironment HostEnvironment
@inject CivicConnectDbContext Db
@inject ICurrentUser CurrentUser
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CivicConnect</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <strong>CivicConnect</strong>
        <nav>
            <a href="/Staff/Queue">Staff queue</a>
        </nav>
        @* Development only: the CR-003 stand-in for sign-in (RSK-012). *@
        @if (HostEnvironment.IsDevelopment())
        {
            var users = await Db.Users.AsNoTracking()
                .OrderBy(u => u.Role).ThenBy(u => u.DisplayName)
                .Select(u => new { u.Id, u.DisplayName, u.Role })
                .ToListAsync();
            <nav class="dev-users" aria-label="Development user switcher">
                Viewing as:
                @foreach (var u in users)
                {
                    if (u.Id == CurrentUser.Id)
                    {
                        <strong>@u.DisplayName (@u.Role)</strong>
                    }
                    else
                    {
                        <a href="/Staff/Queue?user=@u.Id">@u.DisplayName</a>
                    }
                }
            </nav>
        }
    </header>
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
