@page
@model CivicConnect.Web.Pages.Staff.DetailsModel
@{
    ViewData["Title"] = "Request " + Model.Detail!.Reference;
}

<h1>@Model.Detail!.Reference</h1>
<h2>@Model.Detail!.Title</h2>

@if (Model.Message is not null)
{
    <partial name="_Message" model="Model.Message" />
}

@* AC-010.1: requester, category, description and status, with history below. *@
<partial name="_RequestFields" model="Model.Detail" />

@* ADR-004: a control appears only when the capability is present, and the
   handler authorises the action again on post. *@
@if (Model.Capabilities.CanAccept && Model.Detail!.Status == RequestStatus.Received)
{
    <form method="post" asp-page-handler="Accept">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit">Accept this request</button>
    </form>
}

@if (Model.Capabilities.CanReject && Model.Detail!.Status == RequestStatus.Received)
{
    @* CR-009, AC-007.2: the reason is shown to the requester. *@
    <form method="post" asp-page-handler="Reject" class="stacked">
        <input type="hidden" name="id" value="@Model.Id" />
        <label for="reason">Reason for rejecting (the requester will see this)</label>
        <textarea id="reason" name="reason" rows="2" maxlength="@CivicConnect.Application.Requests.NoteService.MaxLength"></textarea>
        <button type="submit" class="danger">Reject this request</button>
    </form>
}

@if (Model.NextStatuses.Count > 0)
{
    <form method="post" asp-page-handler="Transition" class="stacked">
        <input type="hidden" name="id" value="@Model.Id" />
        <label for="next">Move to</label>
        <select id="next" name="next">
            @foreach (var status in Model.NextStatuses)
            {
                <option value="@status">@status</option>
            }
        </select>
        <label for="note">Note (required when resolving, AC-014.1)</label>
        <textarea id="note" name="note" rows="3" maxlength="@CivicConnect.Application.Requests.NoteService.MaxLength"></textarea>
        <button type="submit">Update status</button>
    </form>
}

@if (Model.Capabilities.CanAddNote)
{
    @* FR-013: a comment or action note, kept in the history (AC-013.1). *@
    <form method="post" asp-page-handler="Note" class="stacked">
        <input type="hidden" name="id" value="@Model.Id" />
        <label for="text">Add a note</label>
        <textarea id="text" name="text" rows="3" maxlength="@CivicConnect.Application.Requests.NoteService.MaxLength"></textarea>
        <button type="submit">Add note</button>
    </form>
}

@{
    var notes = Model.History.Entries.Where(h => h.Note is not null).ToList();
}
@if (notes.Count > 0)
{
    <h3>Notes</h3>
    <ul class="history">
        @foreach (var entry in notes)
        {
            <li>
                <time datetime="@entry.OccurredAtUtc.ToString("o")">@entry.OccurredAtUtc.ToString("u")</time>
                @entry.Note
                <span class="actor">by @Model.History.NameOf(entry.ActorUserId)</span>
            </li>
        }
    </ul>
}

<partial name="_Attachments" model="Model.Attachments" />

<h3>Action history</h3>
<partial name="_HistoryList" model="Model.History" />
