@page
@model CivicConnect.Web.Pages.Staff.QueueModel
@using CivicConnect.Application.Abstractions
@{
    ViewData["Title"] = "Staff queue";
}

<h1>Staff queue</h1>

@if (Model.Message is not null)
{
    <partial name="_Message" model="Model.Message" />
}

@if (!Model.IsStaff)
{
    <partial name="_EmptyState" model="@("The staff queue is for service staff. Use Switch user at the top to sign in as one.")" />
}
else
{
    @* FR-009: filter, search and sort within what this staff member may see. *@
    <form method="get" class="filters">
        <label>
            Status
            <select name="status">
                <option value="">Any</option>
                @foreach (var status in Enum.GetValues<RequestStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@(status == RequestStatus.InProgress ? "In progress" : status.ToString())</option>
                }
            </select>
        </label>
        <label>
            Category
            <select name="categoryId">
                <option value="">Any</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                }
            </select>
        </label>
        <label>
            Search
            <input name="q" value="@Model.Q" placeholder="Title or reference" />
        </label>
        <label class="inline-check">
            <input type="checkbox" name="mine" value="true" checked="@Model.Mine" />
            Mine only
        </label>
        <label>
            Sort
            <select name="sort">
                @foreach (var sort in Enum.GetValues<QueueSort>())
                {
                    <option value="@sort" selected="@(Model.Sort == sort)">@sort</option>
                }
            </select>
        </label>
        <button type="submit" class="secondary">Apply</button>
        @if (Model.Filtered)
        {
            <a href="/Staff/Queue">Clear filters</a>
        }
    </form>

    @if (Model.Items.Count == 0)
    {
        @* AC-009.2: a clear message when nothing matches. *@
        <partial name="_EmptyState" model="@(Model.Filtered ? "No requests match these filters." : "Your queue is empty.")" />
    }
    else
    {
        @* FR-016: overdue rows are tinted and tagged. FR-011: a request nobody
           owns can be accepted here; the handler authorises it again. *@
        <table class="data queue">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th>Respond by</th>
                    <th><span class="hint">Action</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="request-summary@(item.Overdue ? " is-overdue" : "")">
                        <td><a href="/Staff/Details?id=@item.Id">@item.Reference</a></td>
                        <td>@item.Title</td>
                        <td>@item.Category</td>
                        <td>
                            <status-badge status="@item.Status"></status-badge>
                            @if (item.Overdue)
                            {
                                <span class="overdue">Overdue</span>
                            }
                        </td>
                        <td><time datetime="@item.CreatedAtUtc.ToString("o")">@DisplayTime.Show(item.CreatedAtUtc)</time></td>
                        <td><time datetime="@item.TargetResponseAtUtc.ToString("o")">@DisplayTime.Show(item.TargetResponseAtUtc)</time></td>
                        <td class="actions">
                            @if (!item.IsAssigned && item.Status == RequestStatus.Received)
                            {
                                <form method="post" asp-page="/Staff/Queue" asp-page-handler="Accept" asp-all-route-data="Model.RouteValues" class="inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="small">Accept</button>
                                </form>
                            }
                            else if (item.IsAssigned)
                            {
                                <span class="owned">Yours</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <nav class="paging" aria-label="Queue pages">
        @if (Model.PageNumber > 1)
        {
            <a href="@Model.LinkTo(Model.PageNumber - 1)">Previous</a>
        }
        <span>Page @Model.PageNumber</span>
        @if (Model.HasNextPage)
        {
            <a href="@Model.LinkTo(Model.PageNumber + 1)">Next</a>
        }
    </nav>
}
